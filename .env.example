# Neon is provisioned with `neon deploy` (config in neon.ts). These values are
# pulled automatically into .env; this file documents what the app needs.

# Pooled connection — application traffic (Neon PgBouncer).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection — migrations, seeding, pg_dump.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth), written by `neon deploy`.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Application secret for cached session cookies — openssl rand -base64 32.
NEON_AUTH_COOKIE_SECRET=

APP_URL=http://localhost:3000
NGFI_MIN_APPLICABLE_WEIGHT_PERCENT=60

# Account that receives platform access when it signs in for the first time.
BOOTSTRAP_ADMIN_EMAIL=admin@denhamandgrey.com
